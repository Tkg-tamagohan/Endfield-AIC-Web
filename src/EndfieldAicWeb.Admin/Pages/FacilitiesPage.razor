@page "/facilities"
@inject AdminDocumentService Store

<PageTitle>設備 - Endfield AIC 管理ツール</PageTitle>

<EntityEditLayout TEntity="Facility"
                  EditorTitle="設備編集"
                  EmptyHint="下の一覧から設備を選ぶか、新規追加してください。"
                  @bind-Selected="_selected"
                  Collection="doc => doc.Facilities"
                  IdPrefix="fac"
                  CreateEntity="(_, id) => EntityFactory.NewFacility(id)"
                  FindReferences="MasterReferenceFinder.FindFacilityReferences">
    <EntityFields Context="facility">
        <div class="form-grid">
            <label>幅</label>
            <span><NumberInput Value="@facility.Width" Owner="facility" Field="Width" ValueChanged="v => Store.ApplyNum(x => facility.Width = x, v)" /></span>

            <label>高さ</label>
            <span><NumberInput Value="@facility.Height" Owner="facility" Field="Height" ValueChanged="v => Store.ApplyNum(x => facility.Height = x, v)" /></span>

            <label>消費電力</label>
            <span><NumberInput Value="@facility.PowerConsumption" Owner="facility" Field="PowerConsumption" ValueChanged="v => Store.ApplyNum(x => facility.PowerConsumption = x, v)" /></span>
        </div>
    </EntityFields>
</EntityEditLayout>

@code {
    [SupplyParameterFromQuery]
    public string? Select { get; set; }

    private Facility? _selected;

    protected override void OnParametersSet()
    {
        if (Store.IsLoaded && Select is { } id)
        {
            _selected = Store.Document!.Facilities.FirstOrDefault(f => f.Id == id);
        }
    }
}
