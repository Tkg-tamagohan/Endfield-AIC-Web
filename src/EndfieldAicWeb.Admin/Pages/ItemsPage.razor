@page "/items"
@inject AdminDocumentService Store

<PageTitle>アイテム - Endfield AIC 管理ツール</PageTitle>

<EntityEditLayout TEntity="Item"
                  EditorTitle="アイテム編集"
                  EmptyHint="下の一覧からアイテムを選ぶか、新規追加してください。"
                  @bind-Selected="_selected"
                  Collection="doc => doc.Items"
                  IdPrefix="item"
                  CreateEntity="(_, id) => EntityFactory.NewItem(id)"
                  FindReferences="MasterReferenceFinder.FindItemReferences"
                  ExtraSearchOf="i => i.Category"
                  CategoryOf="i => i.Category">
    <EntityFields Context="item">
        <div class="form-grid">
            <label>カテゴリ</label>
            <div>
                <input class="input" list="item-category-list" value="@item.Category"
                       @onchange="e => Store.ApplyText(v => item.Category = v, e)" />
                <datalist id="item-category-list">
                    @foreach (string category in ItemCatalog.Categories(Store.Document!.Items))
                    {
                        <option value="@category"></option>
                    }
                </datalist>
                <p class="hint">既存のカテゴリが候補に出ます。新しい名前も入力できます。</p>
            </div>

            <label>天然資源</label>
            <span class="check">
                <input type="checkbox" checked="@item.IsGatherable"
                       @onchange="e => Store.ApplyBool(v => item.IsGatherable = v, e)" />
                <span>外部調達扱い（需要展開の終端）</span>
            </span>

            <label>輸送種別</label>
            <select class="input" value="@item.TransportKind" @onchange="OnTransportChanged">
                @foreach (TransportKind kind in Enum.GetValues<TransportKind>())
                {
                    <option value="@kind">@TransportLabel(kind)</option>
                }
            </select>

            <label>所属イベント</label>
            <RefSelect Value="@item.GameEventId" Options="_eventOptions" EmptyLabel="（常設）"
                       ValueChanged="v => Store.ApplyRef(v => item.GameEventId = v, v)" />
        </div>
    </EntityFields>
</EntityEditLayout>

@code {
    [SupplyParameterFromQuery]
    public string? Select { get; set; }

    private Item? _selected;
    private IReadOnlyList<SelectOption> _eventOptions = [];

    protected override void OnParametersSet()
    {
        if (!Store.IsLoaded)
        {
            return;
        }

        _eventOptions = SelectOption.Of(Store.Document!.GameEvents);
        if (Select is { } id)
        {
            _selected = Store.Document.Items.FirstOrDefault(i => i.Id == id);
        }
    }

    private void OnTransportChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse(e.Value?.ToString(), out TransportKind kind))
        {
            _selected!.TransportKind = kind;
            Store.NotifyChanged();
        }
    }

    private static string TransportLabel(TransportKind kind) => kind switch
    {
        TransportKind.None => "None（仮想アイテム）",
        TransportKind.Belt => "Belt（ベルト）",
        TransportKind.Pipe => "Pipe（パイプ）",
        _ => kind.ToString(),
    };
}
