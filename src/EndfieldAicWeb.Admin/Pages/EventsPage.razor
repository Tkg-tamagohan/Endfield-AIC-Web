@page "/events"
@inject AdminDocumentService Store

<PageTitle>イベント - Endfield AIC 管理ツール</PageTitle>

<EntityEditLayout TEntity="GameEvent"
                  EditorTitle="イベント編集"
                  EmptyHint="下の一覧からイベントを選ぶか、新規追加してください。"
                  @bind-Selected="_selected"
                  Collection="doc => doc.GameEvents"
                  IdPrefix="ev"
                  CreateEntity="(_, id) => EntityFactory.NewGameEvent(id)"
                  FindReferences="MasterReferenceFinder.FindGameEventReferences"
                  HintPrefix="両方空欄は常設イベントです。">
    <EntityFields Context="gameEvent">
        <div class="form-grid">
            <label>開始（UTC）</label>
            <input class="input" type="datetime-local" value="@DateText(gameEvent.ActiveFrom)"
                   @onchange="e => Store.ApplyDate(v => gameEvent.ActiveFrom = v, e)" />

            <label>終了（UTC）</label>
            <input class="input" type="datetime-local" value="@DateText(gameEvent.ActiveTo)"
                   @onchange="e => Store.ApplyDate(v => gameEvent.ActiveTo = v, e)" />
        </div>
    </EntityFields>
</EntityEditLayout>

@code {
    [SupplyParameterFromQuery]
    public string? Select { get; set; }

    private GameEvent? _selected;

    protected override void OnParametersSet()
    {
        if (Store.IsLoaded && Select is { } id)
        {
            _selected = Store.Document!.GameEvents.FirstOrDefault(e => e.Id == id);
        }
    }

    private static string DateText(DateTime? value) =>
        value?.ToString("yyyy-MM-ddTHH:mm", System.Globalization.CultureInfo.InvariantCulture) ?? "";
}
