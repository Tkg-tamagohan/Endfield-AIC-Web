@page "/environments"
@inject AdminDocumentService Store

<PageTitle>環境 - Endfield AIC 管理ツール</PageTitle>

<EntityEditLayout TEntity="DomainEnv"
                  EditorTitle="環境編集"
                  EmptyHint="下の一覧から環境を選ぶか、新規追加してください。"
                  @bind-Selected="_selected"
                  Collection="doc => doc.Environments"
                  IdPrefix="env"
                  CreateEntity="CreateEnvironment"
                  FindReferences="MasterReferenceFinder.FindEnvironmentReferences">
    <EntityFields Context="env">
        <div class="form-grid">
            <label>供給設備（散布機）</label>
            <RefSelect Value="@env.ProviderFacilityId" Options="_facilityOptions" EmptyLabel="（未選択）"
                       ValueChanged="SetProvider" />

            <label>消費アイテム</label>
            <ItemPicker Value="@env.ConsumeItemId" Items="_fuelItems" LookupItems="_allItems"
                        ValueChanged="SetConsumeItem" />

            <label>消費速度（個/分）</label>
            <span><NumberInput Value="@env.ConsumeRatePerMinute" Owner="env" Field="ConsumeRatePerMinute" ValueChanged="v => Store.ApplyNum(x => env.ConsumeRatePerMinute = x, v)" /></span>

            <label>カバー可能台数</label>
            <span><NumberInput Value="@env.CoverableMachines" Owner="env" Field="CoverableMachines" ValueChanged="v => Store.ApplyNum(x => env.CoverableMachines = (int)x, v)" /></span>

            <label>所属イベント</label>
            <RefSelect Value="@env.GameEventId" Options="_eventOptions" EmptyLabel="（常設）"
                       ValueChanged="v => Store.ApplyRef(v => env.GameEventId = v, v)" />
        </div>
    </EntityFields>
</EntityEditLayout>

@code {
    [SupplyParameterFromQuery]
    public string? Select { get; set; }

    private DomainEnv? _selected;
    private IReadOnlyList<SelectOption> _facilityOptions = [];
    private IReadOnlyList<Item> _allItems = [];
    private IReadOnlyList<Item> _fuelItems = [];
    private IReadOnlyList<SelectOption> _eventOptions = [];

    protected override void OnParametersSet()
    {
        if (!Store.IsLoaded)
        {
            return;
        }

        _facilityOptions = SelectOption.Of(Store.Document!.Facilities);
        _allItems = Store.Document.Items;
        _fuelItems = ItemCatalog.FuelItems(Store.Document.Items);
        _eventOptions = SelectOption.Of(Store.Document.GameEvents);
        if (Select is { } id)
        {
            _selected = Store.Document.Environments.FirstOrDefault(e => e.Id == id);
        }
    }

    private static DomainEnv CreateEnvironment(MasterDocument doc, string id) =>
        EntityFactory.NewEnvironment(
            id,
            providerFacilityId: doc.Facilities.FirstOrDefault()?.Id,
            consumeItemId: ItemCatalog.FuelItems(doc.Items).FirstOrDefault()?.Id);

    private void SetProvider(string? value)
    {
        _selected!.ProviderFacilityId = value ?? "";
        Store.NotifyChanged();
    }

    private void SetConsumeItem(string? value)
    {
        _selected!.ConsumeItemId = value ?? "";
        Store.NotifyChanged();
    }
}
