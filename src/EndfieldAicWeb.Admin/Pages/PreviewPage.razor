@page "/preview"
@using System.Globalization
@inject AdminDocumentService Store
@inject CalculationService Calculator

<PageTitle>計算プレビュー - Endfield AIC 管理ツール</PageTitle>

@if (!Store.IsLoaded)
{
    <section class="panel"><p class="muted">ホームで正本 JSON を読み込んでください。</p></section>
}
else if (_snapshotErrors.Count > 0)
{
    <section class="panel">
        <h2 class="panel-title">文書に違反があるため計算できません（@_snapshotErrors.Count 件）</h2>
        <ValidationErrorList Errors="_snapshotErrors" />
    </section>
}
else
{
    <div class="layout">
        <section class="panel">
            <h2 class="panel-title">生産リスト（個/分）</h2>
            <p class="hint">編集中データで計算します。アイテムと必要数（個/分）を入力してください。</p>
            @foreach (TargetRow row in _targetRows)
            {
                <div class="target-row">
                    <RefSelect Value="@row.ItemId" Options="_itemOptions" EmptyLabel="（アイテムを選択）"
                               ValueChanged="v => row.ItemId = v" />
                    <input class="input rate" @bind="row.RateText" @bind:event="oninput" inputmode="decimal" placeholder="0" />
                    <button class="btn ghost" title="行を削除" @onclick="() => RemoveRow(row)">×</button>
                </div>
            }
            <button class="btn" @onclick="AddRow">＋ 行を追加</button>

            @if (_eventChecks.Count > 0)
            {
                <h2 class="panel-title">有効イベント</h2>
                @foreach (EventCheck check in _autoEventChecks)
                {
                    <label class="check">
                        <input type="checkbox" checked="@check.Checked" @onchange="e => OnEventToggled(check, e)" />
                        <EntityIcon IconKey="@check.Event.IconKey" />
                        <span>@check.Event.Name@EventPeriod(check.Event)</span>
                    </label>
                }
                @if (_outEventChecks.Count > 0)
                {
                    <details class="past-events">
                        <summary>期間外のイベントを選択（@_outEventChecks.Count 件）</summary>
                        @foreach (EventCheck check in _outEventChecks)
                        {
                            <label class="check">
                                <input type="checkbox" checked="@check.Checked" @onchange="e => OnEventToggled(check, e)" />
                                <EntityIcon IconKey="@check.Event.IconKey" />
                                <span>@check.Event.Name@EventPeriod(check.Event)</span>
                            </label>
                        }
                    </details>
                }
            }

            @if (_inputError is not null)
            {
                <p class="error">@_inputError</p>
            }
            <button class="btn primary" @onclick="Recalculate">計算</button>
            <p class="hint">データ版 @Store.Document!.DataVersion ・ @Store.SourceLabel</p>
        </section>

        <section class="panel">
            @if (_view is null)
            {
                <p class="muted">左の生産リストを入力して「計算」を押してください。</p>
            }
            else
            {
                <div class="toolbar">
                    <div class="segmented">
                        <button class="seg @(_unadjusted ? "" : "on")" @onclick="() => SetView(false)">調整済</button>
                        <button class="seg @(_unadjusted ? "on" : "")" @onclick="() => SetView(true)">未調整</button>
                    </div>
                </div>
                @if (_view.Warnings.Count > 0)
                {
                    <div class="warnings">
                        @foreach (CalculationWarning w in _view.Warnings)
                        {
                            <div class="warn">⚠ @w.Message</div>
                        }
                    </div>
                }

                <h2 class="panel-title">素材</h2>
                @foreach (MaterialViewRow m in _view.Materials)
                {
                    <div class="mat-row">
                        <div class="mat-head">
                            <EntityIcon IconKey="@ItemIconKey(m.ItemId)" />
                            <strong>@ItemName(m.ItemId)</strong>
                            @if (IsEventItem(m.ItemId))
                            {
                                <span class="tag">イベント</span>
                            }
                            <span class="muted">@Fmt(m.RequiredPerMinute) 個/分</span>
                            @if (m.UnmetPerMinute > 1e-9)
                            {
                                <span class="danger">未充足 @Fmt(m.UnmetPerMinute) 個/分</span>
                            }
                        </div>
                        <div class="mat-body">
                            @foreach (SupplyPortion s in m.Supplies)
                            {
                                <span class="chip">
                                    @if (s.RecipeId is not null)
                                    {
                                        <EntityIcon IconKey="@RecipeIconKey(s.RecipeId)" />
                                    }
                                    @SupplyText(s)
                                </span>
                            }
                        </div>
                    </div>
                }

                <h2 class="panel-title">設備</h2>
                @foreach (FacilityViewRow f in _view.Facilities)
                {
                    <div class="result-line">
                        <EntityIcon IconKey="@FacilityIconKey(f.FacilityId)" />
                        <strong>@FacilityName(f.FacilityId)</strong>
                        <span class="muted"> @f.ExactCount.ToString("0.##", CultureInfo.InvariantCulture) 台 → </span><strong>@f.CeilCount 台</strong>
                        @foreach (FlowAdjustment l in f.FlowLimits)
                        {
                            <div class="hint">@RecipeName(l.RecipeId) の @ItemName(l.InputItemId) を @l.RecommendedLimitPerSecond.ToString("0.###", CultureInfo.InvariantCulture)/秒 に制限</div>
                        }
                    </div>
                }

                @if (_view.Environments.Count > 0)
                {
                    <h2 class="panel-title">環境</h2>
                    @foreach (EnvironmentRequirement e in _view.Environments)
                    {
                        <div class="result-line">
                            <EntityIcon IconKey="@EnvIconKey(e.EnvironmentId)" />
                            <strong>@EnvName(e.EnvironmentId)</strong>
                            <span class="muted"> @FacilityName(e.ProviderFacilityId) @e.DispenserCount 台 ・ @ItemName(e.ConsumeItemId) @e.ConsumeRatePerSecondTotal.ToString("0.##", CultureInfo.InvariantCulture) 個/s</span>
                        </div>
                    }
                }

                <h2 class="panel-title">消費電力</h2>
                <div class="result-line">
                    <strong>@_view.TotalPowerConsumption.ToString("0.##", CultureInfo.InvariantCulture)</strong>
                    <span class="muted">（消費側の合計。発電側は計算しません）</span>
                </div>

                <h2 class="panel-title">余剰</h2>
                @if (_view.Surpluses.Count == 0)
                {
                    <p class="muted">余剰はありません。</p>
                }
                else
                {
                    @foreach (SurplusProduction s in _view.Surpluses)
                    {
                        <div class="result-line">
                            <EntityIcon IconKey="@ItemIconKey(s.ItemId)" />
                            <strong>@ItemName(s.ItemId)</strong>
                            <span class="muted"> +@Fmt(s.ExcessPerMinute) 個/分</span>
                        </div>
                    }
                }
            }
        </section>
    </div>
}

@code {
    private sealed class TargetRow
    {
        public string? ItemId;
        public string RateText = "60";
    }

    private readonly List<TargetRow> _targetRows = [new()];
    private List<EventCheck> _eventChecks = [];
    private List<EventCheck> _autoEventChecks = [];
    private List<EventCheck> _outEventChecks = [];
    private IReadOnlyList<SelectOption> _itemOptions = [];
    private DateOnly _today = DateOnly.FromDateTime(DateTime.Now);

    private CalculationOutcome? _outcome;
    private ResultView? _view;
    private ContextFilter _context = new();
    private string? _inputError;
    private bool _unadjusted;
    private bool _viewTouched;

    private MasterDataSnapshot? _snapshot;
    private IReadOnlyList<MasterValidationError> _snapshotErrors = [];

    protected override void OnInitialized()
    {
        if (EnsureSnapshot())
        {
            _itemOptions = _snapshot!.Items
                .Where(i => i.TransportKind != TransportKind.None)
                .Select(i => new SelectOption(i.Id, i.Name))
                .ToList();
            _eventChecks = CalculationInputBuilder.InitializeEventChecks(_snapshot.GameEvents, _today);
            _autoEventChecks = _eventChecks.Where(c => c.IsActiveByDefault).ToList();
            _outEventChecks = _eventChecks.Where(c => !c.IsActiveByDefault).ToList();
        }
    }

    /// <summary>違反があるとスナップショット構築で例外になるため、先に検証してから作る。</summary>
    private bool EnsureSnapshot()
    {
        if (!Store.IsLoaded)
        {
            _snapshot = null;
            _snapshotErrors = [];
            return false;
        }

        Store.Validate();
        if (Store.ValidationErrors.Count > 0)
        {
            _snapshotErrors = Store.ValidationErrors;
            _snapshot = null;
            return false;
        }

        _snapshotErrors = [];
        _snapshot = Store.Snapshot;
        return true;
    }

    private void AddRow() => _targetRows.Add(new TargetRow());

    private void RemoveRow(TargetRow row)
    {
        _targetRows.Remove(row);
        if (_targetRows.Count == 0)
        {
            _targetRows.Add(new TargetRow());
        }
    }

    private void OnEventToggled(EventCheck check, ChangeEventArgs e)
    {
        check.Checked = e.Value is true;
        Recalculate();
    }

    private void SetView(bool unadjusted)
    {
        _unadjusted = unadjusted;
        _viewTouched = true;
        RebuildView();
    }

    private void Recalculate()
    {
        _inputError = null;
        _outcome = null;
        _view = null;
        if (!EnsureSnapshot() || _snapshot is not { } snapshot)
        {
            return;
        }

        if (!CalculationInputBuilder.TryParseTargets(
                _targetRows.Select(r => new TargetRowInput(r.ItemId, r.RateText)),
                snapshot,
                out List<ProductionTarget> targets,
                out string? error))
        {
            _inputError = error;
            return;
        }

        _context = new ContextFilter
        {
            ActiveGameEventIds = _eventChecks.Where(c => c.Checked).Select(c => c.Event.Id).ToList(),
        };

        try
        {
            _outcome = Calculator.Calculate(snapshot, targets, _context, [], []);
        }
        catch (Exception ex)
        {
            _outcome = null;
            _view = null;
            _inputError = $"計算に失敗しました: {ex.Message}";
            return;
        }

        if (!_viewTouched)
        {
            _unadjusted = PlanViewDefaults.DefaultUnadjusted(_outcome.Plan);
        }

        RebuildView();
    }

    private void RebuildView()
    {
        if (_outcome is not null && _snapshot is not null)
        {
            _view = ResultViewBuilder.Build(_outcome.Plan, _snapshot, _context, _unadjusted);
        }
    }

    private static string Fmt(double perMinute) => perMinute.ToString("0.##", CultureInfo.InvariantCulture);

    private string SupplyText(SupplyPortion portion) => portion.Kind switch
    {
        SupplyKind.Recipe => $"レシピ {RecipeName(portion.RecipeId!)} {Fmt(portion.AmountPerMinute)} 個/分",
        SupplyKind.Byproduct => $"副産物 {RecipeName(portion.RecipeId!)} {Fmt(portion.AmountPerMinute)} 個/分",
        _ => $"基礎素材 {Fmt(portion.AmountPerMinute)} 個/分",
    };

    private string EventPeriod(GameEvent gameEvent)
    {
        if (gameEvent.ActiveFrom is null && gameEvent.ActiveTo is null)
        {
            return "";
        }

        string from = gameEvent.ActiveFrom?.ToString("MM/dd") ?? "";
        string to = gameEvent.ActiveTo?.ToString("MM/dd") ?? "";
        return $"（{from}〜{to}）";
    }

    private bool IsEventItem(string itemId) =>
        _snapshot is not null && _snapshot.ItemsById.TryGetValue(itemId, out Item? item) && item.GameEventId is not null;

    private string? ItemIconKey(string id) =>
        _snapshot is not null && _snapshot.ItemsById.TryGetValue(id, out Item? item) ? item.IconKey : null;

    private string? FacilityIconKey(string id) =>
        _snapshot is not null && _snapshot.FacilitiesById.TryGetValue(id, out Facility? facility) ? facility.IconKey : null;

    private string? EnvIconKey(string id) =>
        _snapshot is not null && _snapshot.EnvironmentsById.TryGetValue(id, out DomainEnv? env) ? env.IconKey : null;

    /// <summary>レシピの実効 IconKey（未設定時は主出力アイテムへフォールバック）。</summary>
    private string? RecipeIconKey(string id) =>
        _snapshot is not null && _snapshot.RecipesById.TryGetValue(id, out Recipe? recipe)
            ? Store.EffectiveIconKey(recipe)
            : null;

    private string ItemName(string id) =>
        _snapshot is not null && _snapshot.ItemsById.TryGetValue(id, out Item? item) ? item.Name : id;

    private string FacilityName(string id) =>
        _snapshot is not null && _snapshot.FacilitiesById.TryGetValue(id, out Facility? facility) ? facility.Name : id;

    private string RecipeName(string id) =>
        _snapshot is not null && _snapshot.RecipesById.TryGetValue(id, out Recipe? recipe) ? recipe.Name : id;

    private string EnvName(string id) =>
        _snapshot is not null && _snapshot.EnvironmentsById.TryGetValue(id, out DomainEnv? env) ? env.Name : id;
}
