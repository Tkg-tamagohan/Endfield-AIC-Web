@page "/preview"
@inject AdminDocumentService Store

<PageTitle>計算プレビュー - Endfield AIC 管理ツール</PageTitle>

@if (!Store.IsLoaded)
{
    <section class="panel"><p class="muted">ホームでマスタ JSON を読み込んでください。</p></section>
}
else if (_snapshotErrors.Count > 0)
{
    <section class="panel">
        <h2 class="panel-title">文書に違反があるため計算できません（@_snapshotErrors.Count 件）</h2>
        <ValidationErrorList Errors="_snapshotErrors" />
    </section>
}
else
{
    <CalculatorPanel SnapshotSource="GetSnapshot"
                     OnSnapshotRejected="OnSnapshotRejected"
                     HeaderHint="編集中データで計算します。アイテムと必要数（個/分）を入力してください。"
                     VersionLabel="@VersionLabel" />
}

@code {
    private MasterDataSnapshot? _snapshot;
    private IReadOnlyList<MasterValidationError> _snapshotErrors = [];

    protected override void OnInitialized() => EnsureSnapshot();

    /// <summary>違反があるとスナップショット構築で例外になるため、先に検証してから作る。</summary>
    private bool EnsureSnapshot()
    {
        if (!Store.IsLoaded)
        {
            _snapshot = null;
            _snapshotErrors = [];
            return false;
        }

        Store.Validate();
        if (Store.ValidationErrors.Count > 0)
        {
            _snapshotErrors = Store.ValidationErrors;
            _snapshot = null;
            return false;
        }

        _snapshotErrors = [];
        _snapshot = Store.Snapshot;
        return true;
    }

    private MasterDataSnapshot? GetSnapshot() => EnsureSnapshot() ? _snapshot : null;

    /// <summary>パネル側の再計算でスナップショット構築が拒否されたとき、ページのゲートへ戻すため再描画を受ける。</summary>
    private void OnSnapshotRejected()
    {
    }

    private string VersionLabel => $"データ版 {Store.Document!.DataVersion} ・ {Store.SourceLabel}";
}
