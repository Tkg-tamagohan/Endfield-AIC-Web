@inject NavigationManager Nav

<ul class="error-list">
    @foreach (MasterValidationError err in Errors)
    {
        <li>
            @if (EntityPage(err.EntityKind) is { } page && !string.IsNullOrEmpty(err.EntityId))
            {
                <button class="link" @onclick="() => GoToEntity(err)">
                    @err.EntityKind @EntityText(err)
                </button>
            }
            else
            {
                <span>@err.EntityKind @EntityText(err)</span>
            }
            @if (!string.IsNullOrEmpty(err.Field))
            {
                <span> @err.Field</span>
            }
            — @err.Message
        </li>
    }
</ul>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<MasterValidationError> Errors { get; set; } = [];

    /// <summary>EntityId を `名前（Id）` へ解決する文書。未取得時は Id のみ表示する（仕様決定 CF）。</summary>
    [Parameter]
    public MasterDocument? Document { get; set; }

    private EntityDisplay? _display;

    protected override void OnParametersSet()
    {
        _display = Document is { } doc ? new EntityDisplay(doc) : null;
    }

    private string EntityText(MasterValidationError err) =>
        _display?.For(err.EntityKind, err.EntityId) ?? err.EntityId;

    private void GoToEntity(MasterValidationError err)
    {
        if (EntityPage(err.EntityKind) is { } page && !string.IsNullOrEmpty(err.EntityId))
        {
            Nav.NavigateTo($"{page}?select={Uri.EscapeDataString(err.EntityId)}");
        }
    }

    private static string? EntityPage(string kind) => kind switch
    {
        "Item" => "items",
        "Facility" => "facilities",
        "Environment" => "environments",
        "GameEvent" => "events",
        "GameMap" => "maps",
        "Recipe" => "recipes",
        _ => null,
    };
}
