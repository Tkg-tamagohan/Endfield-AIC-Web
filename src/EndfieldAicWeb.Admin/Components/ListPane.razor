@typeparam TItem

<div class="entity-pane">
    <div class="entity-pane-head">
        <input class="input" placeholder="絞り込み" value="@_filter" @oninput="OnFilterInput" />
        <button class="btn" @onclick="OnNew">＋ 新規</button>
    </div>
    <div class="entity-list">
        @foreach (TItem item in Filtered())
        {
            string key = KeyOf(item);
            <div class="entity-row @(key == SelectedKey ? "selected" : "")" @onclick="() => OnSelect.InvokeAsync(key)">
                <span class="entity-row-label">
                    @TextOf(item)
                    @if (SubOf(item) is { Length: > 0 } sub)
                    {
                        <span class="entity-row-sub">@sub</span>
                    }
                </span>
                <button class="btn ghost" title="削除" @onclick="() => OnDelete.InvokeAsync(item)"
                        @onclick:stopPropagation>×</button>
            </div>
        }
        @if (!Filtered().Any())
        {
            <p class="muted">該当する項目がありません。</p>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<TItem> Items { get; set; } = [];

    [Parameter, EditorRequired]
    public Func<TItem, string> KeyOf { get; set; } = default!;

    [Parameter, EditorRequired]
    public Func<TItem, string> TextOf { get; set; } = default!;

    /// <summary>サブタイトル（カテゴリ・Id 等）。null/空は非表示。</summary>
    [Parameter]
    public Func<TItem, string?> SubOf { get; set; } = _ => null;

    [Parameter]
    public string? SelectedKey { get; set; }

    [Parameter]
    public EventCallback<string> OnSelect { get; set; }

    [Parameter]
    public EventCallback OnNew { get; set; }

    /// <summary>削除要求。確認は呼び出し側で行う。</summary>
    [Parameter]
    public EventCallback<TItem> OnDelete { get; set; }

    private string _filter = "";

    private void OnFilterInput(ChangeEventArgs e) => _filter = e.Value?.ToString() ?? "";

    private IEnumerable<TItem> Filtered()
    {
        if (string.IsNullOrWhiteSpace(_filter))
        {
            return Items;
        }

        string q = _filter.Trim();
        return Items.Where(i =>
            KeyOf(i).Contains(q, StringComparison.OrdinalIgnoreCase)
            || TextOf(i).Contains(q, StringComparison.OrdinalIgnoreCase));
    }
}
