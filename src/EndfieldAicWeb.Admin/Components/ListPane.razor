@typeparam TItem

<div class="entity-pane">
    <div class="entity-pane-head">
        <input class="input" placeholder="絞り込み" value="@_filter" @oninput="OnFilterInput" />
        @if (CategoryOf is not null)
        {
            <select class="input pane-category" value="@(_category ?? "")" @onchange="OnCategoryChanged">
                <option value="">カテゴリ</option>
                @foreach (string category in Categories())
                {
                    <option value="@category">@category</option>
                }
            </select>
        }
        <button class="btn" @onclick="OnNew">＋ 新規</button>
    </div>
    <div class="entity-list">
        @foreach (TItem item in Filtered())
        {
            string key = KeyOf(item);
            <div class="entity-row @(key == SelectedKey ? "selected" : "")" @onclick="() => OnSelect.InvokeAsync(key)">
                <span class="entity-row-label">
                    @TextOf(item)
                    @if (SubOf(item) is { Length: > 0 } sub)
                    {
                        <span class="entity-row-sub">@sub</span>
                    }
                </span>
                <button class="btn ghost" title="削除" @onclick="() => OnDelete.InvokeAsync(item)"
                        @onclick:stopPropagation>×</button>
            </div>
        }
        @if (!Filtered().Any())
        {
            <p class="muted">該当する項目がありません。</p>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<TItem> Items { get; set; } = [];

    [Parameter, EditorRequired]
    public Func<TItem, string> KeyOf { get; set; } = default!;

    [Parameter, EditorRequired]
    public Func<TItem, string> TextOf { get; set; } = default!;

    /// <summary>サブタイトル（カテゴリ・Id 等）。null/空は非表示。</summary>
    [Parameter]
    public Func<TItem, string?> SubOf { get; set; } = _ => null;

    /// <summary>絞り込みの追加対象（カテゴリ等）。未指定時は Key と Text のみ。</summary>
    [Parameter]
    public Func<TItem, string?>? ExtraSearchOf { get; set; }

    /// <summary>カテゴリ絞り込みの対象値。指定時は検索窓の横にカテゴリ select を出す（仕様決定 AS）。</summary>
    [Parameter]
    public Func<TItem, string?>? CategoryOf { get; set; }

    [Parameter]
    public string? SelectedKey { get; set; }

    [Parameter]
    public EventCallback<string> OnSelect { get; set; }

    [Parameter]
    public EventCallback OnNew { get; set; }

    /// <summary>削除要求。確認は呼び出し側で行う。</summary>
    [Parameter]
    public EventCallback<TItem> OnDelete { get; set; }

    private string _filter = "";
    private string? _category;

    /// <summary>Items 側で選択中のカテゴリが消えたとき絞り込みを解除し、一覧が空転しないようにする。</summary>
    protected override void OnParametersSet()
    {
        if (_category is not null && CategoryOf is not null
            && !Items.Select(CategoryOf).Contains(_category, StringComparer.Ordinal))
        {
            _category = null;
        }
    }

    private void OnFilterInput(ChangeEventArgs e) => _filter = e.Value?.ToString() ?? "";

    private void OnCategoryChanged(ChangeEventArgs e)
    {
        string? value = e.Value?.ToString();
        _category = string.IsNullOrEmpty(value) ? null : value;
    }

    private IEnumerable<string> Categories()
    {
        var seen = new HashSet<string>(StringComparer.Ordinal);
        foreach (TItem item in Items)
        {
            string? category = CategoryOf?.Invoke(item);
            if (!string.IsNullOrWhiteSpace(category) && seen.Add(category))
            {
                yield return category;
            }
        }
    }

    private IEnumerable<TItem> Filtered()
    {
        IEnumerable<TItem> items = Items;
        if (_category is not null)
        {
            items = items.Where(i => CategoryOf?.Invoke(i) == _category);
        }

        if (string.IsNullOrWhiteSpace(_filter))
        {
            return items;
        }

        string q = _filter.Trim();
        return items.Where(i =>
            KeyOf(i).Contains(q, StringComparison.OrdinalIgnoreCase)
            || TextOf(i).Contains(q, StringComparison.OrdinalIgnoreCase)
            || (ExtraSearchOf?.Invoke(i)?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
    }
}
