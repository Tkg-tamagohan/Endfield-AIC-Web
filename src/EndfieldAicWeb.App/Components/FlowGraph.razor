@* 生産フローグラフ（仕様決定 AI/AJ）。canvas は WebGPU がエッジと粒子を描き、ノードは DOM カードが担う。 *@
@using System.Globalization
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="flow-graph-wrap">
    <canvas @ref="_canvas" class="flow-canvas"></canvas>
    <div @ref="_layer" class="fnode-layer">
        @foreach (FlowGraphNode n in Model.Nodes)
        {
            <div class="fnode @NodeClass(n)" data-node-id="@n.Id" role="button" tabindex="0" @key="n.Id"
                 @onclick="() => OnNodeClick(n)">
                <EntityIcon IconKey="@n.IconKey" />
                <span class="fnode-text">
                    <span class="fnode-label">@n.Label</span>
                    <span class="fnode-meta">@NodeMeta(n)</span>
                </span>
            </div>
        }
    </div>
</div>
<p class="hint">ドラッグで移動、ホイールで拡大・縮小できます。ノードを押すと下のリストへジャンプします。</p>

@code {
    /// <summary>表示するグラフモデル（FlowGraphModelBuilder の出力）。</summary>
    [Parameter, EditorRequired] public required FlowGraphModel Model { get; set; }

    /// <summary>流量の表示フォーマット。表示単位に追従させるため親から渡す。</summary>
    [Parameter] public Func<double, string>? FormatRate { get; set; }

    /// <summary>WebGPU が使えず描画を諦めたときに親へ通知する。</summary>
    [Parameter] public EventCallback OnUnavailable { get; set; }

    private ElementReference _canvas;
    private ElementReference _layer;
    private IJSObjectReference? _module;
    private IJSObjectReference? _handle;
    private bool _updatePending = true;
    private bool _unavailableNotified;

    protected override void OnParametersSet() => _updatePending = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/flow-graph.js");
            _handle = await _module.InvokeAsync<IJSObjectReference?>("create", _canvas, _layer);
            if (_handle is null)
            {
                if (!_unavailableNotified)
                {
                    _unavailableNotified = true;
                    await OnUnavailable.InvokeAsync();
                }
                return;
            }
        }
        if (_handle is not null && _updatePending)
        {
            _updatePending = false;
            await _handle.InvokeVoidAsync("update", Model);
        }
    }

    private string NodeClass(FlowGraphNode n)
    {
        string cls = n.Kind switch
        {
            FlowGraphNodeKind.Facility => "fnode-fac",
            FlowGraphNodeKind.Gather => "fnode-gather",
            _ => "fnode-item",
        };
        if (n.IsTarget)
        {
            cls += " fnode-target";
        }
        if (n.OverCapacity || n.UnmetPerMinute > 1e-9)
        {
            cls += " fnode-alert";
        }
        return cls;
    }

    private string NodeMeta(FlowGraphNode n) => n.Kind switch
    {
        FlowGraphNodeKind.Facility => n.Note ?? "",
        FlowGraphNodeKind.Gather => FmtRate(
            Model.Edges.Where(e => e.Kind == FlowGraphEdgeKind.Gathered).Sum(e => e.RatePerMinute)),
        _ => ItemMeta(n),
    };

    private string ItemMeta(FlowGraphNode n)
    {
        var parts = new List<string>();
        if (n.RequiredPerMinute > 1e-9)
        {
            parts.Add(FmtRate(n.RequiredPerMinute));
        }
        if (n.UnmetPerMinute > 1e-9)
        {
            parts.Add($"未充足 {FmtRate(n.UnmetPerMinute)}");
        }
        if (n.SurplusPerMinute > 1e-9)
        {
            parts.Add($"余剰 +{FmtRate(n.SurplusPerMinute)}");
        }
        return string.Join("・", parts);
    }

    private string FmtRate(double value) =>
        FormatRate?.Invoke(value) ?? value.ToString("0.##", CultureInfo.InvariantCulture);

    private async Task OnNodeClick(FlowGraphNode n)
    {
        if (n.RefId is not null && _module is not null)
        {
            await _module.InvokeVoidAsync("scrollToRef", n.RefId);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_handle is not null)
            {
                await _handle.InvokeVoidAsync("dispose");
                await _handle.DisposeAsync();
            }
            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
