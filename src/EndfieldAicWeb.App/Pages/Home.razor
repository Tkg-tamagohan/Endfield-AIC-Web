@page "/"
@using EndfieldAicWeb.Domain.Validation
@inject MasterDataService MasterData
@inject IconCatalog Icons

<PageTitle>Endfield AIC 計算</PageTitle>

@if (!MasterData.IsLoaded)
{
    @if (MasterData.LoadError is null && MasterData.Errors.Count == 0)
    {
        <p class="muted">マスタデータを読み込み中…</p>
    }
    else
    {
        <section class="panel">
            <h2 class="panel-title">マスタデータを読み込めません</h2>
            @if (MasterData.LoadError is not null)
            {
                <p class="error">@MasterData.LoadError</p>
            }
            <ul class="error-list">
                @foreach (var err in MasterData.Errors)
                {
                    <li>@err.EntityKind @EntityText(err) @err.Field — @err.Message</li>
                }
            </ul>
        </section>
    }
}
else
{
    <CalculatorPanel SnapshotSource="GetSnapshot"
                     HeaderHint="アイテムと必要数（個/分）を入力してください。"
                     VersionLabel="@VersionLabel" />
}

@code {
    protected override async Task OnInitializedAsync()
    {
        await MasterData.LoadAsync();
        if (MasterData.IsLoaded)
        {
            await Icons.LoadAsync(MasterData.Document!);
        }
    }

    private MasterDataSnapshot? GetSnapshot() => MasterData.Snapshot;

    private string VersionLabel => $"データ版 {MasterData.Document?.DataVersion}";

    private EntityDisplay? _display;
    private MasterDocument? _displayDocument;

    /// <summary>エラーのエンティティ参照を `名前（Id）` へ整形する（仕様決定 CF）。文書未取得時は Id のみ。
    /// 読み込み直しで文書が差し替わったら解決器を作り直す。</summary>
    private string EntityText(MasterValidationError err)
    {
        if (!ReferenceEquals(_displayDocument, MasterData.Document))
        {
            _displayDocument = MasterData.Document;
            _display = _displayDocument is { } doc ? new EntityDisplay(doc) : null;
        }

        return _display?.For(err.EntityKind, err.EntityId) ?? err.EntityId;
    }
}
