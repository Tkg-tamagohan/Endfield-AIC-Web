<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.31" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.31" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EndfieldAicWeb.Application\EndfieldAicWeb.Application.csproj" />
    <ProjectReference Include="..\EndfieldAicWeb.Infrastructure\EndfieldAicWeb.Infrastructure.csproj" />
    <ProjectReference Include="..\EndfieldAicWeb.SharedUi\EndfieldAicWeb.SharedUi.csproj" />
  </ItemGroup>

  <!-- 原本のマスタ JSON を wwwroot へコピーして静的アセットとして配信する（生成物なので gitignore 済み）。 -->
  <!-- 暗黙の wwwroot アセット列挙は評価時に行われるため、クリーン環境の初回ビルドでは
       コピー先ファイルが列挙に間に合わない。開発用の wwwroot コピーに加えて、
       発行成果物へも直接コピーして publish の欠落を防ぐ。 -->
  <Target Name="CopyMasterJson" BeforeTargets="AssignTargetPaths">
    <MakeDir Directories="$(MSBuildProjectDirectory)\wwwroot\data" />
    <Copy SourceFiles="..\..\data\master.json" DestinationFiles="$(MSBuildProjectDirectory)\wwwroot\data\master.json" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RepoIcons)" DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\data\icons" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyMasterJsonToPublish" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)\wwwroot\data" />
    <Copy SourceFiles="..\..\data\master.json" DestinationFiles="$(PublishDir)\wwwroot\data\master.json" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RepoIcons)" DestinationFolder="$(PublishDir)\wwwroot\data\icons" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <!-- data/icons/ の画像を wwwroot/data/icons へ同梱する（マニフェストの File 形式 icons/<Key>.png に対応）。
         *.png のみ対象とし、.gitkeep 等の非画像は載せない。ディレクトリに画像がない間はコピー対象なしで通る。 -->
    <RepoIcons Include="..\..\data\icons\**\*.png" />
  </ItemGroup>

</Project>
