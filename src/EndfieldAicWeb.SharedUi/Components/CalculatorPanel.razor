@* 計算ページ本体（仕様決定 BB）。公開版・管理ツール共通の入力パネルと結果パネル。
   差異は SnapshotSource・ヒント文・各パラメータで吸収し、ページ側は読み込みゲートのみ持つ。 *@
@using System.Globalization
@implements IAsyncDisposable
@inject CalculationService Calculator
@inject ICalculatorIcons Icons
@inject IJSRuntime JS

<div class="layout">
    <section class="panel">
        <h2 class="panel-title">生産リスト（個/分）</h2>
        <p class="hint">@HeaderHint</p>
        @foreach (TargetRow row in _targetRows)
        {
            <div class="target-row" @key="row">
                <select class="input row-category" value="@(row.Category ?? "")" @onchange="e => OnCategoryChanged(row, e)">
                    <option value="">カテゴリ</option>
                    @foreach (string category in _itemCategories)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
                <select class="input row-item" @key="row.Category" value="@(row.ItemId ?? "")" @onchange="e => OnItemChanged(row, e)">
                    <option value="">アイテム</option>
                    @foreach (Item item in ItemOptions(row))
                    {
                        <option value="@item.Id">@item.Name@(item.GameEventId is not null && EventItemSuffix ? "（イベント）" : "")</option>
                    }
                </select>
                <input class="input rate" @bind="row.RateText" @bind:event="oninput" inputmode="decimal" placeholder="0" />
                <button class="btn ghost" title="行を削除" @onclick="() => RemoveRow(row)">×</button>
            </div>
        }
        <button class="btn" @onclick="AddRow">＋ 行を追加</button>

        @if (_eventChecks.Count > 0)
        {
            <h2 class="panel-title">有効イベント</h2>
            @foreach (EventCheck check in _autoEventChecks)
            {
                <label class="check">
                    <input type="checkbox" checked="@check.Checked" @onchange="e => OnEventToggled(check, e)" />
                    <EntityIcon IconKey="@check.Event.IconKey" />
                    <span>@check.Event.Name@EventPeriod(check.Event)</span>
                </label>
            }
            @if (_outEventChecks.Count > 0)
            {
                <details class="past-events">
                    <summary>期間外のイベントを選択（@_outEventChecks.Count 件）</summary>
                    @foreach (EventCheck check in _outEventChecks)
                    {
                        <label class="check">
                            <input type="checkbox" checked="@check.Checked" @onchange="e => OnEventToggled(check, e)" />
                            <EntityIcon IconKey="@check.Event.IconKey" />
                            <span>@check.Event.Name@EventPeriod(check.Event)</span>
                        </label>
                    }
                </details>
            }
            @if (EventSectionHint is not null)
            {
                <p class="hint">@EventSectionHint</p>
            }
        }

        <h2 class="panel-title">採取マップ</h2>
        <select class="input" value="@(_mapId ?? "")" @onchange="OnMapChanged">
            <option value="">未選択（採取無制限）</option>
            @foreach (GameMap map in MapCandidates)
            {
                <option value="@map.Id">@map.Name</option>
            }
            @if (_mapId is not null && !MapCandidates.Any(map => map.Id == _mapId))
            {
                string mapName = _snapshot!.MapsById.TryGetValue(_mapId, out GameMap? selectedMap)
                    ? selectedMap.Name
                    : _mapId;
                <option value="@_mapId">@mapName（イベント無効）</option>
            }
        </select>
        <p class="hint">@MapHint</p>

        @if (_inputError is not null)
        {
            <p class="error">@_inputError</p>
        }
        <button class="btn primary" @onclick="Recalculate">計算</button>
        <p class="hint">@VersionLabel</p>
    </section>

    <section class="panel">
        @if (_view is null)
        {
            <p class="muted">左の生産リストを入力して「計算」を押してください。</p>
        }
        else
        {
            <div class="toolbar">
                <div class="segmented">
                    <button class="seg @(_unadjusted ? "" : "on")" @onclick="() => SetView(false)">調整済</button>
                    <button class="seg @(_unadjusted ? "on" : "")" @onclick="() => SetView(true)">未調整</button>
                </div>
                <div class="segmented">
                    <button class="seg @(_unit == AmountUnit.PerMinute ? "on" : "")" @onclick="() => _unit = AmountUnit.PerMinute">毎分</button>
                    <button class="seg @(_unit == AmountUnit.PerSecond ? "on" : "")" @onclick="() => _unit = AmountUnit.PerSecond">毎秒</button>
                    <button class="seg @(_unit == AmountUnit.Period ? "on" : "")" @onclick="() => _unit = AmountUnit.Period">期間</button>
                </div>
                @if (EnableFlowGraph && _graphSupported && _flowModel is not null)
                {
                    <div class="segmented">
                        <button class="seg @(_graphOpen ? "on" : "")" @onclick="() => _graphOpen = true">グラフ</button>
                        <button class="seg @(!_graphOpen ? "on" : "")" @onclick="() => _graphOpen = false">リスト</button>
                    </div>
                }
                @if (EnableFlowGraph && _graphSupported && _graphOpen && _flowModel is not null)
                {
                    <label class="check"><input type="checkbox" checked="@_graphExpandFacilities" @onchange="OnGraphExpandChanged" /> 設備を台数分表示</label>
                }
                @if (_unit == AmountUnit.Period)
                {
                    <span class="period-inputs">
                        <input class="input" @bind="_daysText" @bind:event="oninput" inputmode="decimal" placeholder="0" /> 日
                        <input class="input" @bind="_hoursText" @bind:event="oninput" inputmode="decimal" placeholder="0" /> 時
                        <input class="input" @bind="_minutesText" @bind:event="oninput" inputmode="decimal" placeholder="0" /> 分
                    </span>
                }
            </div>
            @if (_unit == AmountUnit.Period && !PeriodValid())
            {
                <p class="error">期間は 0 以上の数値で入力してください。</p>
            }
            @if (_view.Warnings.Count > 0)
            {
                <div class="warnings">
                    @foreach (CalculationWarning w in _view.Warnings)
                    {
                        <div class="warn">⚠ @w.Message</div>
                    }
                </div>
            }

            @if (EnableFlowGraph && _graphSupported && _graphOpen && _flowModel is not null)
            {
                <h2 class="panel-title">生産フロー</h2>
                <FlowGraph Model="_flowModel" FormatRate="FormatGraphRate" OnUnavailable="OnGraphUnavailable" />
            }

            <h2 class="panel-title">素材</h2>
            @foreach (MaterialViewRow m in _view.Materials)
            {
                <div class="mat-row" data-flow-ref="@m.ItemId">
                    <div class="mat-head">
                        <EntityIcon IconKey="@ItemIconKey(m.ItemId)" />
                        <strong>@ItemName(m.ItemId)</strong>
                        @if (IsEventItem(m.ItemId))
                        {
                            <span class="tag">イベント</span>
                        }
                        <span class="muted">@Fmt(m.RequiredPerMinute)@Suffix()</span>
                        @if (m.UnmetPerMinute > 1e-9)
                        {
                            <span class="danger">未充足 @Fmt(m.UnmetPerMinute)@Suffix()</span>
                        }
                    </div>
                    <div class="mat-body">
                        @foreach (SupplyPortion s in m.Supplies)
                        {
                            <span class="chip">
                                @if (s.RecipeId is not null)
                                {
                                    <EntityIcon IconKey="@Icons.RecipeIconKey(s.RecipeId)" />
                                }
                                @SupplyText(s)
                            </span>
                        }
                        @if (_outcome!.PairOptionsByItemId.TryGetValue(m.ItemId, out IReadOnlyList<PairOption>? options))
                        {
                            <select class="input pair" value="@(m.SelectedPairKey ?? "")" @onchange="e => OnPairChanged(m.ItemId, e)">
                                <option value="">既定（自動選択）</option>
                                @foreach (PairOption o in options)
                                {
                                    <option value="@o.Key">@OptionLabel(o)</option>
                                }
                            </select>
                        }
                    </div>
                </div>
            }

            @if (_mapId is not null && _snapshot is not null
                && MapSelection.IsAvailable(_snapshot, _mapId, ActiveGameEventIds))
            {
                <h2 class="panel-title">採取</h2>
                @if (_gatherError is not null)
                {
                    <p class="error">@_gatherError</p>
                }
                @foreach (GatherInput input in _gatherInputs)
                {
                    <div class="result-line env-line">
                        <EntityIcon IconKey="@ItemIconKey(input.ItemId)" />
                        <strong>@ItemName(input.ItemId)</strong>
                        <input class="input tiny" value="@input.RateText"
                               @onchange="e => OnGatherRateChanged(input.ItemId, e)"
                               inputmode="decimal" placeholder="@GatherRatePlaceholder(input.ItemId)" />
                        個/分
                        <span class="muted">（@GatherRateDefaultLabel(input.ItemId)）</span>
                        <span>採取 @FmtPerMinute(GatheredRate(input.ItemId)) 個/分</span>
                        @if (IsGatherCapReached(input))
                        {
                            <span class="tag">上限到達</span>
                        }
                    </div>
                }
                <p class="hint">空欄はマップの既定値を使います。マップ値を超える値も指定できます。変更すると再計算します。</p>
            }

            <h2 class="panel-title">設備</h2>
            @foreach (FacilityViewRow f in _view.Facilities)
            {
                <div class="result-line" data-flow-ref="@f.FacilityId">
                    <EntityIcon IconKey="@FacilityIconKey(f.FacilityId)" />
                    <strong>@FacilityName(f.FacilityId)</strong>
                    <span class="muted"> @f.ExactCount.ToString("0.##", CultureInfo.InvariantCulture) 台 → </span><strong>@f.CeilCount 台</strong>
                    @foreach (FlowAdjustment l in f.FlowLimits)
                    {
                        <div class="hint">@RecipeName(l.RecipeId) の @ItemName(l.InputItemId) を @l.RecommendedLimitPerMinute.ToString("0.###", CultureInfo.InvariantCulture)/分 に制限</div>
                    }
                </div>
            }

            @if (_view.Environments.Count > 0)
            {
                <h2 class="panel-title">環境</h2>
                <p class="hint">散布機台数を下げると消費量に反映します（自動値が上限）。変更すると再計算します。</p>
                @if (_envError is not null)
                {
                    <p class="error">@_envError</p>
                }
                @foreach (EnvironmentRequirement e in _view.Environments)
                {
                    <div class="result-line env-line">
                        <EntityIcon IconKey="@EnvIconKey(e.EnvironmentId)" />
                        <strong>@EnvName(e.EnvironmentId)</strong>
                        <span class="muted"> @FacilityName(e.ProviderFacilityId)</span>
                        <input class="input tiny" value="@EnvCountText(e.EnvironmentId)"
                               @onchange="ev => OnEnvCountChanged(e.EnvironmentId, ev)"
                               inputmode="numeric" placeholder="自動" /> 台
                        <span class="muted">（自動 @EnvAutoCount(e.EnvironmentId) 台まで）</span>
                        <span> ・ @ItemName(e.ConsumeItemId) @e.ConsumeRatePerMinuteTotal.ToString("0.##", CultureInfo.InvariantCulture) 個/分@(PeriodConsumption(e.ConsumeRatePerMinuteTotal))</span>
                    </div>
                }
            }

            <h2 class="panel-title">消費電力</h2>
            <div class="result-line">
                <strong>@_view.TotalPowerConsumption.ToString("0.##", CultureInfo.InvariantCulture)</strong>
                <span class="muted">（消費側の合計。発電側は計算しません）</span>
            </div>

            <h2 class="panel-title">余剰</h2>
            @if (_view.Surpluses.Count == 0)
            {
                <p class="muted">余剰はありません。</p>
            }
            else
            {
                @foreach (SurplusProduction s in _view.Surpluses)
                {
                    <div class="result-line" data-flow-ref="@s.ItemId">
                        <EntityIcon IconKey="@ItemIconKey(s.ItemId)" />
                        <strong>@ItemName(s.ItemId)</strong>
                        <span class="muted"> +@Fmt(s.ExcessPerMinute)@Suffix()</span>
                    </div>
                }
            }
        }
    </section>
</div>

@code {
    private sealed class TargetRow
    {
        public string? ItemId;
        public string RateText = "30";
        public string? Category;
    }

    private sealed class EnvInput(DomainEnv environment, int max)
    {
        public DomainEnv Env { get; } = environment;
        public int Max { get; set; } = max;
        public string CountText = "";
    }

    private sealed class GatherInput(string itemId)
    {
        public string ItemId { get; } = itemId;
        public string RateText = "";
    }

    /// <summary>計算用スナップショットの取得元。再計算の先頭で呼ぶ。null はスナップショット構築の拒否（検証違反など）。</summary>
    [Parameter, EditorRequired] public required Func<MasterDataSnapshot?> SnapshotSource { get; set; }

    /// <summary>SnapshotSource が null を返したときに発火する。ページ側は自身のゲートを再表示する。</summary>
    [Parameter] public EventCallback OnSnapshotRejected { get; set; }

    /// <summary>生産リスト節のヒント文。</summary>
    [Parameter] public string? HeaderHint { get; set; }

    /// <summary>有効イベント節末尾のヒント文。null のときは出さない。</summary>
    [Parameter] public string? EventSectionHint { get; set; }

    /// <summary>採取マップ節のヒント文。</summary>
    [Parameter] public string? MapHint { get; set; }

    /// <summary>入力パネル末尾のデータ版表示。</summary>
    [Parameter] public string? VersionLabel { get; set; }

    /// <summary>目標アイテムの選択肢名にイベント由来アイテムの「（イベント）」注記を付けるか。</summary>
    [Parameter] public bool EventItemSuffix { get; set; }

    /// <summary>生産フローグラフを有効にするか（仕様決定 AI/BC）。</summary>
    [Parameter] public bool EnableFlowGraph { get; set; }

    private readonly List<TargetRow> _targetRows = [new()];
    private List<EventCheck> _eventChecks = [];
    private List<EventCheck> _autoEventChecks = [];
    private List<EventCheck> _outEventChecks = [];
    private List<EnvInput> _envInputs = [];
    private List<GatherInput> _gatherInputs = [];
    private List<Item> _selectableItems = [];
    private IReadOnlyList<string> _itemCategories = [];
    private readonly Dictionary<string, string> _gatherRateTexts = new(StringComparer.Ordinal);

    /// <summary>ユーザーが選んだペア上書き（アイテム Id → 候補）。既定 = キーなし。</summary>
    private readonly Dictionary<string, PairOption> _pairOverrides = new(StringComparer.Ordinal);

    private MasterDataSnapshot? _snapshot;
    private CalculationOutcome? _outcome;
    private ResultView? _view;
    private FlowGraphModel? _flowModel;
    private IReadOnlyList<ProductionTarget> _targets = [];
    private IJSObjectReference? _graphModule;
    private bool _graphSupported;
    private bool _graphOpen;
    private bool _graphExpandFacilities;
    private ContextFilter _context = new();
    private string? _mapId;
    private string? _inputError;
    private string? _envError;
    private string? _gatherError;
    private bool _unadjusted;
    private bool _viewTouched;
    private AmountUnit _unit = AmountUnit.PerMinute;
    private string _daysText = "0";
    private string _hoursText = "0";
    private string _minutesText = "0";

    protected override async Task OnInitializedAsync()
    {
        _snapshot = SnapshotSource();
        if (_snapshot is null)
        {
            await OnSnapshotRejected.InvokeAsync();
            return;
        }

        _selectableItems = ItemCatalog.WithRecipeOutput(
            _snapshot.Items.Where(i => i.TransportKind != TransportKind.None).ToList(),
            _snapshot.Recipes).ToList();
        _itemCategories = ItemCatalog.Categories(_selectableItems);
        _eventChecks = CalculationInputBuilder.InitializeEventChecks(_snapshot.GameEvents, DateOnly.FromDateTime(DateTime.Now));
        RefreshEventViews(DateOnly.FromDateTime(DateTime.Now));
    }

    private void AddRow() => _targetRows.Add(new TargetRow());

    private void RemoveRow(TargetRow row)
    {
        _targetRows.Remove(row);
        if (_targetRows.Count == 0)
        {
            _targetRows.Add(new TargetRow());
        }
    }

    private void OnCategoryChanged(TargetRow row, ChangeEventArgs e)
    {
        string? value = e.Value?.ToString();
        row.Category = string.IsNullOrEmpty(value) ? null : value;
    }

    private IReadOnlyList<Item> ItemOptions(TargetRow row) =>
        ItemCatalog.OptionsForSelection(_selectableItems, row.Category, row.ItemId, _snapshot!.Items);

    private void OnItemChanged(TargetRow row, ChangeEventArgs e)
    {
        string? value = e.Value?.ToString();
        row.ItemId = string.IsNullOrEmpty(value) ? null : value;
    }

    /// <summary>判定時点の日付で既定を評価し直し、自動・期間外の振り分けを更新する。</summary>
    private void RefreshEventViews(DateOnly today)
    {
        CalculationInputBuilder.RefreshEventCheckDefaults(_eventChecks, today);
        _autoEventChecks = _eventChecks.Where(c => c.IsActiveByDefault).ToList();
        _outEventChecks = _eventChecks.Where(c => !c.IsActiveByDefault).ToList();
    }

    private void OnEventToggled(EventCheck check, ChangeEventArgs e)
    {
        check.Checked = e.Value is true;
        check.Touched = true;
        Recalculate();
    }

    private void OnMapChanged(ChangeEventArgs e)
    {
        string? mapId = e.Value?.ToString();
        _mapId = string.IsNullOrEmpty(mapId) ? null : mapId;
        Recalculate();
    }

    private void OnPairChanged(string itemId, ChangeEventArgs e)
    {
        string? key = e.Value?.ToString();
        if (string.IsNullOrEmpty(key))
        {
            _pairOverrides.Remove(itemId);
        }
        else if (_outcome?.PairOptionsByItemId.TryGetValue(itemId, out IReadOnlyList<PairOption>? options) == true
            && options.FirstOrDefault(o => o.Key == key) is { } option)
        {
            _pairOverrides[itemId] = option;
        }

        Recalculate();
    }

    private IReadOnlyCollection<string> ActiveGameEventIds =>
        _eventChecks.Where(c => c.Checked).Select(c => c.Event.Id).ToList();

    private IReadOnlyList<GameMap> MapCandidates =>
        _snapshot is null ? [] : MapSelection.ListCandidates(_snapshot, ActiveGameEventIds);

    private string EnvCountText(string envId) =>
        _envInputs.FirstOrDefault(r => r.Env.Id == envId)?.CountText ?? "";

    private int EnvAutoCount(string envId) =>
        _envInputs.FirstOrDefault(r => r.Env.Id == envId)?.Max ?? 0;

    private void OnEnvCountChanged(string envId, ChangeEventArgs e)
    {
        if (_envInputs.FirstOrDefault(r => r.Env.Id == envId) is { } input)
        {
            input.CountText = e.Value?.ToString() ?? "";
            Recalculate();
        }
    }

    private void OnGatherRateChanged(string itemId, ChangeEventArgs e)
    {
        if (_gatherInputs.FirstOrDefault(input => input.ItemId == itemId) is { } input)
        {
            input.RateText = e.Value?.ToString() ?? "";
            _gatherRateTexts[itemId] = input.RateText;
            Recalculate();
        }
    }

    private void SetView(bool unadjusted)
    {
        _unadjusted = unadjusted;
        _viewTouched = true;
        RebuildView();
    }

    private void OnGraphExpandChanged(ChangeEventArgs e)
    {
        _graphExpandFacilities = e.Value is true;
        RebuildView();
    }

    private void Recalculate()
    {
        _inputError = null;
        _snapshot = SnapshotSource();
        if (_snapshot is null)
        {
            _ = OnSnapshotRejected.InvokeAsync();
            return;
        }

        RefreshEventViews(DateOnly.FromDateTime(DateTime.Now));

        if (!CalculationInputBuilder.TryParseTargets(
                _targetRows.Select(r => new TargetRowInput(r.ItemId, r.RateText)),
                _snapshot,
                out List<ProductionTarget> targets,
                out string? error))
        {
            _inputError = error;
            return;
        }

        _envError = null;
        if (!CalculationInputBuilder.TryParseEnvironmentCounts(
                _envInputs.Select(r => new EnvCountInput(r.Env.Id, r.Env.Name, r.CountText, r.Max)),
                out List<EnvironmentCountOverride> environmentOverrides,
                out string? envError))
        {
            _envError = envError;
            return;
        }

        _gatherError = null;
        List<string> activeGameEventIds = _eventChecks
            .Where(c => c.Checked)
            .Select(c => c.Event.Id)
            .ToList();
        var context = new ContextFilter
        {
            ActiveGameEventIds = activeGameEventIds,
            MapId = _mapId,
        };
        List<GatherRateOverride> gatherOverrides = [];
        if (_mapId is not null && MapSelection.IsAvailable(_snapshot, _mapId, activeGameEventIds))
        {
            if (!CalculationInputBuilder.TryParseGatherRates(
                    _gatherRateTexts.Select(kv => new GatherRateInput(
                        kv.Key,
                        ItemName(kv.Key),
                        kv.Value)),
                    _snapshot,
                    out gatherOverrides,
                    out string? gatherError))
            {
                _gatherError = gatherError;
                return;
            }
        }

        _context = context;
        _targets = targets;
        var pairOverrides = _pairOverrides.Select(kv => kv.Value.ToOverride(kv.Key)).ToList();

        // 計算失敗は常に捕捉して入力エラー欄へ出す（仕様決定 BE）。
        try
        {
            _outcome = Calculator.Calculate(
                _snapshot,
                targets,
                _context,
                pairOverrides,
                environmentOverrides,
                gatherOverrides);
        }
        catch (Exception ex)
        {
            _outcome = null;
            _view = null;
            _inputError = $"計算に失敗しました: {ex.Message}";
            return;
        }

        if (!_viewTouched)
        {
            _unadjusted = PlanViewDefaults.DefaultUnadjusted(_outcome.Plan);
        }

        // 散布機台数の入力は計算結果に登場する環境だけに出す。
        // ユーザー入力（下げた台数）は再計算をまたいで保持するが、
        // 新しい自動上限を超えた保持値は自動値へ戻す（仕様決定 AH）。
        bool envCountReconciled = false;
        var prevCounts = _envInputs.ToDictionary(r => r.Env.Id, r => r.CountText, StringComparer.Ordinal);
        _envInputs = _outcome.Plan.EnvironmentRequirements
            .Select(r =>
            {
                int max = PlanViewDefaults.DispenserLimit(_outcome.Plan, r.EnvironmentId);
                string kept = CalculationInputBuilder.ReconcileEnvCountText(
                    prevCounts.GetValueOrDefault(r.EnvironmentId, ""), max);
                envCountReconciled |= kept != prevCounts.GetValueOrDefault(r.EnvironmentId, "");
                return new EnvInput(_snapshot.EnvironmentsById[r.EnvironmentId], max)
                {
                    CountText = kept,
                };
            })
            .ToList();

        // 自動値へ戻した行があると表示中の計画は戻す前の台数で計算済みのため、
        // 表示と入力が一致するよう整合後の入力で計算し直す。
        if (envCountReconciled)
        {
            Recalculate();
            return;
        }

        foreach (GatherInput input in _gatherInputs)
        {
            _gatherRateTexts[input.ItemId] = input.RateText;
        }

        IReadOnlyList<string> gatherableItemIds = MapSelection.GatherableItemIds(_outcome.Plan, _snapshot);
        foreach (string itemId in _gatherRateTexts.Keys.ToList())
        {
            if (!gatherableItemIds.Contains(itemId)
                && !CalculationInputBuilder.TryParseGatherRates(
                    [new GatherRateInput(itemId, ItemName(itemId), _gatherRateTexts[itemId])],
                    _snapshot,
                    out _,
                    out _))
            {
                _gatherRateTexts.Remove(itemId);
            }
        }

        _gatherInputs = gatherableItemIds
            .Select(itemId => new GatherInput(itemId)
            {
                RateText = _gatherRateTexts.GetValueOrDefault(itemId, ""),
            })
            .ToList();

        RebuildView();
    }

    private void RebuildView()
    {
        if (_outcome is not null && _snapshot is not null)
        {
            _view = ResultViewBuilder.Build(_outcome.Plan, _snapshot, _context, _unadjusted);
            _flowModel = EnableFlowGraph
                ? FlowGraphModelBuilder.Build(
                    _outcome.Plan, _snapshot, _context, _targets, _unadjusted, _graphExpandFacilities)
                : null;
        }
    }

    // 初回の結果表示後に WebGPU 利用可否を調べ、対応環境だけに切替とグラフ節を出す（仕様決定 AK）。
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (EnableFlowGraph && _graphModule is null && _outcome is not null)
        {
            _graphModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/EndfieldAicWeb.SharedUi/js/flow-graph.js");
            _graphSupported = await _graphModule.InvokeAsync<bool>("webgpuSupported");
            _graphOpen = _graphSupported && (await _graphModule.InvokeAsync<double>("viewportWidth")) >= 781;
            if (_graphSupported)
            {
                StateHasChanged();
            }
        }
    }

    private string FormatGraphRate(double perMinute) => Fmt(perMinute) + Suffix();

    private void OnGraphUnavailable()
    {
        _graphSupported = false;
        _graphOpen = false;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_graphModule is not null)
        {
            try
            {
                await _graphModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private PeriodAmount CurrentPeriod()
    {
        PeriodAmount period = default;
        bool valid =
            TryParsePart(_daysText, out double days) &&
            TryParsePart(_hoursText, out double hours) &&
            TryParsePart(_minutesText, out double minutes) &&
            PeriodAmount.TryCreate(days, hours, minutes, out period);
        return valid ? period : default;
    }

    private bool PeriodValid()
    {
        return TryParsePart(_daysText, out double days)
            && TryParsePart(_hoursText, out double hours)
            && TryParsePart(_minutesText, out double minutes)
            && PeriodAmount.TryCreate(days, hours, minutes, out _);
    }

    private static bool TryParsePart(string text, out double value)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            value = 0;
            return true;
        }

        return double.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out value);
    }

    private string Fmt(double perMinute)
    {
        double converted = AmountConverter.Convert(perMinute, _unit, CurrentPeriod());
        return converted.ToString(_unit == AmountUnit.PerSecond ? "0.###" : "0.##", CultureInfo.InvariantCulture);
    }

    private string Suffix() => AmountConverter.Suffix(_unit);

    private string PeriodConsumption(double ratePerMinute)
    {
        return _unit == AmountUnit.Period && PeriodValid()
            ? $"（{(ratePerMinute * CurrentPeriod().TotalMinutes).ToString("0.##", CultureInfo.InvariantCulture)} 個/期間）"
            : "";
    }

    private string FmtPerMinute(double perMinute) =>
        perMinute.ToString("0.##", CultureInfo.InvariantCulture);

    private double GatheredRate(string itemId) =>
        _outcome?.Plan.ItemRequirements
            .FirstOrDefault(requirement => requirement.ItemId == itemId)?
            .Supplies.Where(supply => supply.Kind == SupplyKind.Gathered)
            .Sum(supply => supply.AmountPerMinute) ?? 0;

    private double RequiredRate(string itemId) =>
        _outcome?.Plan.ItemRequirements
            .FirstOrDefault(requirement => requirement.ItemId == itemId)?
            .RequiredPerMinute ?? 0;

    private double? DefaultGatherCap(string itemId) =>
        _snapshot is null ? null : MapSelection.DefaultGatherCap(_snapshot, _context, itemId);

    private double? EffectiveGatherCap(GatherInput input)
    {
        if (!string.IsNullOrWhiteSpace(input.RateText)
            && double.TryParse(input.RateText, NumberStyles.Float, CultureInfo.InvariantCulture, out double cap)
            && double.IsFinite(cap)
            && cap >= 0)
        {
            return cap;
        }

        return DefaultGatherCap(input.ItemId);
    }

    private string GatherRatePlaceholder(string itemId) =>
        DefaultGatherCap(itemId) is double cap ? FmtPerMinute(cap) : "無制限";

    private string GatherRateDefaultLabel(string itemId) =>
        DefaultGatherCap(itemId) is double cap
            ? $"マップ既定 {FmtPerMinute(cap)} 個/分"
            : "マップ既定 無制限";

    private bool IsGatherCapReached(GatherInput input)
    {
        double? cap = EffectiveGatherCap(input);
        return cap is double value
            && double.IsFinite(value)
            && GatheredRate(input.ItemId) >= value - 1e-9
            && RequiredRate(input.ItemId) > value - 1e-9;
    }

    private string SupplyText(SupplyPortion portion) => portion.Kind switch
    {
        SupplyKind.Recipe => $"レシピ {RecipeName(portion.RecipeId!)} {Fmt(portion.AmountPerMinute)}{Suffix()}",
        SupplyKind.Byproduct => $"副産物 {RecipeName(portion.RecipeId!)} {Fmt(portion.AmountPerMinute)}{Suffix()}",
        SupplyKind.Gathered => $"採取 {Fmt(portion.AmountPerMinute)}{Suffix()}",
        _ => "",
    };

    private string OptionLabel(PairOption option)
    {
        string label = $"{RecipeName(option.RecipeId)} ／ {FacilityName(option.FacilityId)} {option.CycleTime.ToString("0.##", CultureInfo.InvariantCulture)}秒";
        label += option.EnvironmentId is null ? "・環境なし" : $"・{EnvName(option.EnvironmentId)}";
        if (option.FixedConsumption is { } fc)
        {
            label += $"・{ItemName(fc.ItemId)} {fc.RatePerMinute.ToString("0.##", CultureInfo.InvariantCulture)}/分";
        }

        if (option.IsDefault)
        {
            label += "（既定）";
        }

        return label;
    }

    private string EventPeriod(GameEvent gameEvent)
    {
        if (gameEvent.ActiveFrom is null && gameEvent.ActiveTo is null)
        {
            return "";
        }

        string from = gameEvent.ActiveFrom?.ToLocalTime().ToString("MM/dd") ?? "";
        string to = gameEvent.ActiveTo?.ToLocalTime().ToString("MM/dd") ?? "";
        return $"（{from}〜{to}）";
    }

    private string? ItemIconKey(string itemId) =>
        _snapshot is not null && _snapshot.ItemsById.TryGetValue(itemId, out Item? item) ? item.IconKey : null;

    private string? FacilityIconKey(string facilityId) =>
        _snapshot is not null && _snapshot.FacilitiesById.TryGetValue(facilityId, out Facility? f) ? f.IconKey : null;

    private string? EnvIconKey(string envId) =>
        _snapshot is not null && _snapshot.EnvironmentsById.TryGetValue(envId, out DomainEnv? env) ? env.IconKey : null;

    private bool IsEventItem(string itemId) =>
        _snapshot is not null && _snapshot.ItemsById.TryGetValue(itemId, out Item? item) && item.GameEventId is not null;

    private string ItemName(string id) =>
        _snapshot is not null && _snapshot.ItemsById.TryGetValue(id, out Item? item) ? item.Name : id;

    private string FacilityName(string id) =>
        _snapshot is not null && _snapshot.FacilitiesById.TryGetValue(id, out Facility? facility) ? facility.Name : id;

    private string RecipeName(string id) =>
        _snapshot is not null && _snapshot.RecipesById.TryGetValue(id, out Recipe? recipe) ? recipe.Name : id;

    private string EnvName(string id) =>
        _snapshot is not null && _snapshot.EnvironmentsById.TryGetValue(id, out DomainEnv? env) ? env.Name : id;
}
