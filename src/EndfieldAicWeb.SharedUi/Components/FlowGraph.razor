@* 生産フローグラフ（仕様決定 AI/AJ・BJ〜BL・CM・CN）。canvas は WebGPU がエッジと粒子を描き、ノードは DOM カードが担う。
   表示方向・高さ・最大化・台数分表示は親が保持するパラメータで、グラフ⇄リスト切替の再マウントをまたいで維持される。 *@
@using System.Globalization
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="flow-graph@(Maximized ? " flow-max" : "")">
    <div class="flow-toolbar">
        <div class="segmented">
            <button type="button" class="seg@(Vertical ? " on" : "")" @onclick="() => SetVertical(true)">縦</button>
            <button type="button" class="seg@(!Vertical ? " on" : "")" @onclick="() => SetVertical(false)">横</button>
        </div>
        <label class="check"><input type="checkbox" checked="@ExpandFacilities" @onchange="OnExpandFacilitiesChanged" /> 設備を台数分表示</label>
        <button type="button" class="btn ghost flow-maxbtn"
                title="@(Maximized ? "元のサイズに戻す" : "画面いっぱいに表示")"
                @onclick="ToggleMaximize">@(Maximized ? "元に戻す" : "最大化")</button>
    </div>
    <div class="flow-graph-wrap" @ref="_wrap" style="@WrapStyle">
        <canvas @ref="_canvas" class="flow-canvas"></canvas>
        <div @ref="_layer" class="fnode-layer">
            @foreach (FlowGraphNode n in Model.Nodes)
            {
                <button type="button" class="fnode @NodeClass(n)" data-node-id="@n.Id" @key="n.Id"
                     @onclick="() => OnNodeClick(n)">
                    <EntityIcon IconKey="@n.IconKey" />
                    <span class="fnode-text">
                        <span class="fnode-label">@n.Label</span>
                        <span class="fnode-meta">@NodeMeta(n)</span>
                    </span>
                </button>
            }
        </div>
        <div class="flow-zoom" @onpointerdown:stopPropagation="true">
            <button type="button" class="btn flow-zoombtn" title="拡大" @onclick="ZoomIn">＋</button>
            <button type="button" class="btn flow-zoombtn" title="縮小" @onclick="ZoomOut">−</button>
            <button type="button" class="btn flow-zoombtn" title="グラフ全体を領域に収める" @onclick="Fit">フィット</button>
        </div>
        <div @ref="_resizeHandle" class="flow-resize" title="ドラッグで高さを変更・ダブルクリックで自動に戻す"
             @onpointerdown="OnResizeStart" @onpointerdown:stopPropagation="true"
             @ondblclick="OnResizeAuto">
            <span class="flow-resize-grip"></span>
        </div>
    </div>
    <p class="hint">ドラッグで移動、ピンチまたはホイールで拡大・縮小できます。ノードを押すと下のリストへジャンプします。</p>
</div>

@code {
    /// <summary>表示するグラフモデル（FlowGraphModelBuilder の出力）。</summary>
    [Parameter, EditorRequired] public required FlowGraphModel Model { get; set; }

    /// <summary>流量の表示フォーマット。表示単位に追従させるため親から渡す。</summary>
    [Parameter] public Func<double, string>? FormatRate { get; set; }

    /// <summary>FormatRate が読む外部状態をまとめたキー（表示単位・期間入力など）。
    /// 表記が変わりうる値をすべて含める。差分発火はこのキーの変化でも発火させ、
    /// デリゲートが同一のまま表記だけ変わる経路でノード幅の再計測を抜けないようにする。</summary>
    [Parameter] public string? FormatKey { get; set; }

    /// <summary>WebGPU が使えず描画を諦めたときに親へ通知する。</summary>
    [Parameter] public EventCallback OnUnavailable { get; set; }

    /// <summary>縦方向表示（既定）か横方向表示か（仕様決定 BJ）。再マウントをまたぐため親が保持する。</summary>
    [Parameter] public bool Vertical { get; set; } = true;

    /// <summary>Vertical の双方向バインド用コールバック。</summary>
    [Parameter] public EventCallback<bool> VerticalChanged { get; set; }

    /// <summary>領域の高さ（px）。null は自動モード（仕様決定 CM）：内容がズーム 1.0 で収まる高さへ自動で拡張する。
    /// 実効高さは Height ?? _autoHeight で、両方 null なら CSS の既定値（420px、モバイル幅 300px）（仕様決定 BK）。</summary>
    [Parameter] public double? Height { get; set; }

    /// <summary>Height の双方向バインド用コールバック。ドラッグ確定・自動復帰時にのみ通知する。</summary>
    [Parameter] public EventCallback<double?> HeightChanged { get; set; }

    /// <summary>画面全面オーバレイで表示するか（仕様決定 BK）。</summary>
    [Parameter] public bool Maximized { get; set; }

    /// <summary>Maximized の双方向バインド用コールバック。</summary>
    [Parameter] public EventCallback<bool> MaximizedChanged { get; set; }

    /// <summary>設備を実台数ぶん個別に描く台数分表示か（仕様決定 AO・CN）。切替はグラフのツールバーから行う。</summary>
    [Parameter] public bool ExpandFacilities { get; set; }

    /// <summary>ExpandFacilities の双方向バインド用コールバック。</summary>
    [Parameter] public EventCallback<bool> ExpandFacilitiesChanged { get; set; }

    private ElementReference _canvas;
    private ElementReference _layer;
    private ElementReference _wrap;
    private ElementReference _resizeHandle;
    private IJSObjectReference? _module;
    private IJSObjectReference? _resizeTrack;
    private IJSObjectReference? _handle;
    private IJSObjectReference? _escapeSub;
    private DotNetObjectReference<FlowGraph>? _selfRef;
    private bool _updatePending = true;
    private bool _unavailableNotified;
    private bool _scrollLocked;
    private double? _height;
    // JS が通知した自動算出高。手動モード・最大化中も保持を続け、復帰時の再計算を不要にする（仕様決定 CM）。
    private double? _autoHeight;
    // 領域高の自動適用で立つフィット要求。DOM への高さ反映後の描画で refit を呼んで解除する。
    private bool _refitPending;
    private bool _resizing;
    private double _resizeStartH;
    private double _minH = 420;
    // JS update() に適用済みのパラメータ。差分があったときだけ _updatePending を立てる（Phase 38）。
    private FlowGraphModel? _appliedModel;
    private bool _appliedVertical;
    private Func<double, string>? _appliedFormatRate;
    private string? _appliedFormatKey;

    private string? WrapStyle =>
        _height is { } h ? $"height: {h.ToString("0", CultureInfo.InvariantCulture)}px" : null;

    protected override void OnParametersSet()
    {
        // update() は全ジオメトリの再構築を伴うため、内容に効くパラメータが変わったときだけ発火する。
        // モデル不変の親再レンダー（キー入力・最大化・高さ確定など）では走らせない。
        // FormatRate はデリゲートの同一性（対象・メソッド）で比較する。
        if (!ReferenceEquals(Model, _appliedModel)
            || Vertical != _appliedVertical
            || !Equals(FormatRate, _appliedFormatRate)
            || FormatKey != _appliedFormatKey)
        {
            _updatePending = true;
        }
        if (!_resizing)
        {
            // 実効高さは手動指定優先・未指定なら自動算出値（仕様決定 CM）。適用高さが変わるたびに
            // フィットを掛け直す。自動への復帰（Height→null）もこの経路で再適用される。
            double? next = Height ?? _autoHeight;
            if (next != _height)
            {
                _height = next;
                _refitPending = true;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/EndfieldAicWeb.SharedUi/js/flow-graph.js");
            _selfRef = DotNetObjectReference.Create(this);
            _escapeSub = await _module.InvokeAsync<IJSObjectReference>("registerEscape", _selfRef);
            _handle = await _module.InvokeAsync<IJSObjectReference?>("create", _canvas, _layer, _selfRef);
            if (_handle is null)
            {
                if (!_unavailableNotified)
                {
                    _unavailableNotified = true;
                    await OnUnavailable.InvokeAsync();
                }
                return;
            }
        }
        if (_handle is not null && _updatePending)
        {
            _updatePending = false;
            _appliedModel = Model;
            _appliedVertical = Vertical;
            _appliedFormatRate = FormatRate;
            _appliedFormatKey = FormatKey;
            await _handle.InvokeVoidAsync("update", Model, Vertical);
        }
        // DOM への高さ反映のあとでないと fitView が古い領域高を読むため、
        // 通知を受けた直後ではなく描画後のこの位置でフィットを掛け直す（仕様決定 CM）。
        if (_handle is not null && _refitPending)
        {
            _refitPending = false;
            await _handle.InvokeVoidAsync("refit");
        }
        // 最大化状態へスクロール抑止を同期する（再マウント時に最大化が維持される場合を含む）。
        if (_module is not null && _scrollLocked != Maximized)
        {
            _scrollLocked = Maximized;
            await _module.InvokeVoidAsync("setScrollLock", Maximized);
        }
    }

    private string NodeClass(FlowGraphNode n)
    {
        string cls = n.Kind switch
        {
            FlowGraphNodeKind.Facility => "fnode-fac",
            _ => "fnode-item",
        };
        // 採取供給のあるアイテムは緑系の fnode-gather を併用する（仕様決定 BO）。
        if (n.GatheredPerMinute > 1e-9)
        {
            cls += " fnode-gather";
        }
        // 処理消費のあるアイテムは紫系の fnode-disposal を併用する（仕様決定 CD）。
        if (n.Disposals.Count > 0)
        {
            cls += " fnode-disposal";
        }
        if (n.IsTarget)
        {
            cls += " fnode-target";
        }
        if (n.UnmetPerMinute > 1e-9)
        {
            cls += " fnode-alert";
        }
        return cls;
    }

    private string NodeMeta(FlowGraphNode n) => n.Kind switch
    {
        FlowGraphNodeKind.Facility => n.Note ?? "",
        _ => ItemMeta(n),
    };

    private string ItemMeta(FlowGraphNode n)
    {
        var parts = new List<string>();
        if (n.RequiredPerMinute > 1e-9)
        {
            parts.Add(FmtRate(n.RequiredPerMinute));
        }
        if (n.UnmetPerMinute > 1e-9)
        {
            parts.Add($"未充足 {FmtRate(n.UnmetPerMinute)}");
        }
        if (n.SurplusPerMinute > 1e-9)
        {
            parts.Add($"余剰 +{FmtRate(n.SurplusPerMinute)}");
        }
        if (n.GatheredPerMinute > 1e-9)
        {
            parts.Add($"採取 {FmtRate(n.GatheredPerMinute)}");
        }
        // 処理消費は「処理 〈設備名〉×〈台数〉・〈処理量〉」の形で併記する（仕様決定 CD・暫定解釈 4）。
        if (n.Disposals.Count > 0)
        {
            string facilities = string.Join(
                "・",
                n.Disposals.Select(d => $"{d.FacilityName}×{d.Count}"));
            parts.Add($"処理 {facilities}・{FmtRate(n.Disposals.Sum(d => d.PerMinute))}");
        }
        return string.Join("・", parts);
    }

    private string FmtRate(double value) =>
        FormatRate?.Invoke(value) ?? value.ToString("0.##", CultureInfo.InvariantCulture);

    private async Task OnNodeClick(FlowGraphNode n)
    {
        if (n.RefId is not null && _module is not null)
        {
            // 最大化オーバレイの下ではジャンプ先の行が見えないため、先に復帰してからスクロールする。
            if (Maximized)
            {
                await MaximizedChanged.InvokeAsync(false);
            }
            await _module.InvokeVoidAsync("scrollToRef", n.RefId);
        }
    }

    private async Task SetVertical(bool vertical)
    {
        if (vertical != Vertical)
        {
            await VerticalChanged.InvokeAsync(vertical);
        }
    }

    private async Task ToggleMaximize() => await MaximizedChanged.InvokeAsync(!Maximized);

    /// <summary>内容がズーム 1.0 で収まる領域高の通知（flow-graph.js の update・ResizeObserver から呼ばれる）。
    /// 自動モード・非最大化のときだけ実効高さへ適用し、適用ごとにフィットを掛け直す（仕様決定 CM）。</summary>
    [JSInvokable]
    public void OnContentHeight(double height)
    {
        // 手動モード・最大化中も保持だけは更新し、復帰時の再評価を不要にする。
        _autoHeight = height;
        // リサイズ中の適用はドラッグ中の _height を上書きするため除外する。
        if (Height is null && !Maximized && !_resizing && _height != height)
        {
            _height = height;
            _refitPending = true;
            StateHasChanged();
        }
    }

    /// <summary>Esc で最大化を復帰する（flow-graph.js の registerEscape から呼ばれる）。</summary>
    [JSInvokable]
    public async Task OnEscapeKey()
    {
        if (Maximized)
        {
            await MaximizedChanged.InvokeAsync(false);
        }
    }

    /// <summary>描画中の実行時失敗を JS 側から受け取り、初期化失敗と同じ経路でグラフ節を畳む（仕様決定 CJ）。
    /// JS 側は fail でリソースを解放済みだが、相互運用参照も畳むため dispose を試みる。
    /// 失敗後のハンドル操作は no-op であり、ここでの呼び出しは無害である。</summary>
    [JSInvokable]
    public async Task OnGraphFailed()
    {
        if (_handle is not null)
        {
            try
            {
                await _handle.InvokeVoidAsync("dispose");
                await _handle.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            _handle = null;
        }
        if (!_unavailableNotified)
        {
            _unavailableNotified = true;
            await OnUnavailable.InvokeAsync();
        }
    }

    private async Task ZoomIn()
    {
        if (_handle is not null)
        {
            await _handle.InvokeVoidAsync("zoomStep", 1);
        }
    }

    private async Task ZoomOut()
    {
        if (_handle is not null)
        {
            await _handle.InvokeVoidAsync("zoomStep", -1);
        }
    }

    private async Task Fit()
    {
        if (_handle is not null)
        {
            await _handle.InvokeVoidAsync("refit");
        }
    }

    private async Task OnResizeStart(PointerEventArgs e)
    {
        if (_module is null || _selfRef is null)
        {
            return;
        }
        _minH = await _module.InvokeAsync<double>("minGraphHeight");
        _resizing = true;
        _resizeStartH = _height ?? _minH;
        _height = _resizeStartH;
        if (_resizeTrack is not null)
        {
            await _resizeTrack.DisposeAsync();
            _resizeTrack = null;
        }
        // ドラッグ中の高さ追従は JS 側の style 更新だけで行い、pointermove ごとの
        // パネル再レンダーを起こさない。確定高は OnResizeCommitted で受け取る（Phase 38）。
        _resizeTrack = await _module.InvokeAsync<IJSObjectReference>(
            "trackResizeDrag", _wrap, e.PointerId, e.ClientY, _resizeStartH, _minH, _selfRef);
        await _module.InvokeVoidAsync("capturePointer", _resizeHandle, e.PointerId);
    }

    /// <summary>リサイズドラッグの確定（flow-graph.js の trackResizeDrag から呼ばれる）。
    /// 実効高さが開始時と変わったときだけ手動モードへ移行する。位置を動かさなかった
    /// クリックでは発火せず、ハンドルを一度だけ押しても自動モードが止まらない（仕様決定 CM）。</summary>
    [JSInvokable]
    public async Task OnResizeCommitted(double height)
    {
        _resizing = false;
        _height = height;
        if (_resizeTrack is not null)
        {
            await _resizeTrack.DisposeAsync();
            _resizeTrack = null;
        }
        if (height != _resizeStartH)
        {
            await HeightChanged.InvokeAsync(_height);
        }
    }

    /// <summary>リサイズハンドルのダブルクリックで手動指定を解除し自動へ復帰する（仕様決定 CM）。</summary>
    private async Task OnResizeAuto() => await HeightChanged.InvokeAsync(null);

    private async Task OnExpandFacilitiesChanged(ChangeEventArgs e)
    {
        await ExpandFacilitiesChanged.InvokeAsync(e.Value is true);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_handle is not null)
            {
                await _handle.InvokeVoidAsync("dispose");
                await _handle.DisposeAsync();
            }
            if (_escapeSub is not null)
            {
                // DisposeAsync は相互運用参照の解放だけで JS 側の dispose() は呼ばない。
                // document の keydown リスナーが再マウントごとに蓄積するため先に解除する。
                await _escapeSub.InvokeVoidAsync("dispose");
                await _escapeSub.DisposeAsync();
            }
            if (_resizeTrack is not null)
            {
                await _resizeTrack.DisposeAsync();
                _resizeTrack = null;
            }
            if (_module is not null)
            {
                if (_scrollLocked)
                {
                    await _module.InvokeVoidAsync("setScrollLock", false);
                }
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
        _selfRef?.Dispose();
    }
}
