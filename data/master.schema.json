{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tkg-tamagohan/Endfield-AIC-Web/data/master.schema.json",
  "title": "AIC マスタ JSON（SchemaVersion=1）",
  "description": "正本マスタデータの構造定義。エンティティのフィールド構成のみを定める。参照整合性・ペア一意性・enum 定義値の意味検証など、文書をまたいだ規則は Domain の検証（requirements §5、仕様決定 P/R）で扱い、本スキーマの対象外とする。",
  "type": "object",
  "required": ["SchemaVersion", "DataVersion", "Items", "Facilities", "Environments", "GameEvents", "Recipes", "Maps", "Icons"],
  "additionalProperties": false,
  "properties": {
    "SchemaVersion": { "const": 1 },
    "DataVersion": { "type": "string", "minLength": 1 },
    "Items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "Facilities": { "type": "array", "items": { "$ref": "#/$defs/facility" } },
    "Environments": { "type": "array", "items": { "$ref": "#/$defs/environment" } },
    "GameEvents": { "type": "array", "items": { "$ref": "#/$defs/gameEvent" } },
    "Recipes": { "type": "array", "items": { "$ref": "#/$defs/recipe" } },
    "Maps": { "type": "array", "items": { "$ref": "#/$defs/gameMap" } },
    "Icons": { "type": "array", "items": { "$ref": "#/$defs/icon" } }
  },
  "$defs": {
    "commonAttributes": {
      "type": "object",
      "required": ["Id", "Name", "Description", "IconKey", "VersionAdded", "VersionRemoved"],
      "properties": {
        "Id": { "type": "string", "minLength": 1 },
        "Name": { "type": "string", "minLength": 1 },
        "Description": { "type": "string" },
        "IconKey": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]{0,64}$(?![\\s\\S])" },
        "VersionAdded": { "type": "string", "minLength": 1 },
        "VersionRemoved": { "type": ["string", "null"] }
      }
    },
    "item": {
      "allOf": [
        { "$ref": "#/$defs/commonAttributes" },
        {
          "type": "object",
          "required": ["Category", "IsGatherable", "TransportKind", "GameEventId"],
          "properties": {
            "Category": { "type": "string", "minLength": 1, "description": "表示用の分類タグ（計算の判定には使わない）" },
            "IsGatherable": { "type": "boolean", "description": "需要展開の終端となる採取素材か（true なら外部調達扱い）" },
            "TransportKind": { "enum": ["None", "Belt", "Pipe"], "description": "None は仮想アイテム（輸送容量対象外）" },
            "GameEventId": { "type": ["string", "null"], "description": "null=常設" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "facility": {
      "allOf": [
        { "$ref": "#/$defs/commonAttributes" },
        {
          "type": "object",
          "required": ["Width", "Height", "PowerConsumption"],
          "properties": {
            "Width": { "type": "number", "exclusiveMinimum": 0 },
            "Height": { "type": "number", "exclusiveMinimum": 0 },
            "PowerConsumption": { "type": "number", "minimum": 0 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "environment": {
      "allOf": [
        { "$ref": "#/$defs/commonAttributes" },
        {
          "type": "object",
          "required": ["ProviderFacilityId", "ConsumeItemId", "ConsumeRatePerMinute", "GameEventId"],
          "properties": {
            "ProviderFacilityId": { "type": "string", "minLength": 1 },
            "ConsumeItemId": { "type": "string", "minLength": 1 },
            "ConsumeRatePerMinute": { "type": "number", "exclusiveMinimum": 0 },
            "GameEventId": { "type": ["string", "null"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "gameEvent": {
      "allOf": [
        { "$ref": "#/$defs/commonAttributes" },
        {
          "type": "object",
          "required": ["ActiveFrom", "ActiveTo"],
          "properties": {
            "ActiveFrom": { "type": ["string", "null"], "format": "date-time", "description": "両 null は常設" },
            "ActiveTo": { "type": ["string", "null"], "format": "date-time" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "recipeIo": {
      "type": "object",
      "required": ["ItemId", "Quantity"],
      "additionalProperties": false,
      "properties": {
        "ItemId": { "type": "string", "minLength": 1 },
        "Quantity": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "recipeOutput": {
      "type": "object",
      "required": ["ItemId", "Quantity", "SortOrder"],
      "additionalProperties": false,
      "properties": {
        "ItemId": { "type": "string", "minLength": 1 },
        "Quantity": { "type": "number", "exclusiveMinimum": 0 },
        "SortOrder": { "type": "integer", "minimum": 0, "description": "0 が主産物" }
      }
    },
    "fixedConsumption": {
      "type": "object",
      "required": ["ItemId", "RatePerMinute"],
      "additionalProperties": false,
      "properties": {
        "ItemId": { "type": "string", "minLength": 1 },
        "RatePerMinute": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "recipeFacility": {
      "type": "object",
      "description": "RecipeFacility ペア。RecipeId は所属レシピから与えられるため JSON 上は持たない。一意性は (RecipeId, FacilityId, CycleTime, EnvironmentId, FixedConsumption) の組で判定（仕様決定 P）",
      "required": ["FacilityId", "CycleTime", "EnvironmentId", "FixedConsumption"],
      "additionalProperties": false,
      "properties": {
        "FacilityId": { "type": "string", "minLength": 1 },
        "CycleTime": { "type": "number", "exclusiveMinimum": 0 },
        "EnvironmentId": { "type": ["string", "null"], "description": "null=環境不要" },
        "FixedConsumption": { "oneOf": [{ "$ref": "#/$defs/fixedConsumption" }, { "type": "null" }] }
      }
    },
    "recipe": {
      "allOf": [
        { "$ref": "#/$defs/commonAttributes" },
        {
          "type": "object",
          "required": ["Inputs", "Outputs", "Facilities", "GameEventId"],
          "properties": {
            "Inputs": { "type": "array", "items": { "$ref": "#/$defs/recipeIo" } },
            "Outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/recipeOutput" } },
            "Facilities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/recipeFacility" } },
            "GameEventId": { "type": ["string", "null"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "gatherRate": {
      "type": "object",
      "required": ["ItemId", "IsUnlimited", "RatePerMinute"],
      "additionalProperties": false,
      "properties": {
        "ItemId": { "type": "string", "minLength": 1 },
        "IsUnlimited": { "type": "boolean" },
        "RatePerMinute": { "type": ["number", "null"], "exclusiveMinimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "IsUnlimited": { "const": false } }, "required": ["IsUnlimited"] },
          "then": { "properties": { "RatePerMinute": { "type": "number", "exclusiveMinimum": 0 } } }
        },
        {
          "if": { "properties": { "IsUnlimited": { "const": true } }, "required": ["IsUnlimited"] },
          "then": { "properties": { "RatePerMinute": { "type": "null" } } }
        }
      ]
    },
    "gameMap": {
      "allOf": [
        { "$ref": "#/$defs/commonAttributes" },
        {
          "type": "object",
          "required": ["GameEventId", "GatherRates"],
          "properties": {
            "GameEventId": { "type": ["string", "null"], "description": "null=常設" },
            "GatherRates": { "type": "array", "items": { "$ref": "#/$defs/gatherRate" } }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "icon": {
      "type": "object",
      "required": ["Key", "File", "Sha256", "Bytes"],
      "additionalProperties": false,
      "properties": {
        "Key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$(?![\\s\\S])" },
        "File": { "type": "string", "minLength": 1 },
        "Sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "Bytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
